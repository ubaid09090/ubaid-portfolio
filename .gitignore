# .gitignore

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules
dist
dist-ssr
*.local

# Build outputs
*.tsbuildinfo
*.tsbuildinfo
.eslintcache
.cache
build
coverage

# Environment variables
.env
.env.*
!.env.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.editorconfig

# Testing
coverage
.nyc_output
.vitest

# Misc
*.pem
*.key
*.crt
*.p12
node_modules/.vite
vite.config.js.timestamp-*